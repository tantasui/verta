# Environment variables
.env
.env.local
.env.production

# Uploads (videos and thumbnails should not be committed)
uploads/videos/*
uploads/thumbnails/*
!uploads/videos/.gitkeep
!uploads/thumbnails/.gitkeep

# Walrus cache (downloaded blobs should not be committed)
cache/videos/*
!cache/videos/.gitkeep

# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules/

# OS
.DS_Store
